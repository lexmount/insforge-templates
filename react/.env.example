# InsForge Configuration
# Get these values from your InsForge dashboard: https://insforge.dev

# Your InsForge backend URL (required for authentication)
VITE_INSFORGE_BASE_URL=https://your-app.region.insforge.app

# Anonymous key (required for auth, database, and storage operations)
VITE_INSFORGE_ANON_KEY=your_insforge_anon_key_here

# Platform-managed analytics (production only)
VITE_GA_MEASUREMENT_ID=
VITE_INSFORGE_APP_ID=
VITE_INSFORGE_ENVIRONMENT_ID=
VITE_INSFORGE_TEMPLATE_ID=react
VITE_INSFORGE_TEMPLATE_VERSION_ID=
VITE_INSFORGE_RELEASE_ID=
